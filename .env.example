# Настройки PostgreSQL — общие для docker-compose.yml и backend.
POSTGRES_DB=six_seven
POSTGRES_USER=six_seven
POSTGRES_PASSWORD=local_dev_password
# Если порт 5432 занят локальным PostgreSQL, поставьте, например, 5433.
POSTGRES_PORT=5432
# Хост БД для backend, запущенного локально (не в Docker).
POSTGRES_HOST=localhost

# Необязательные настройки игры (значения по умолчанию — в backend/app/config.py).
# COOLDOWN_MS=1500
# FRAME_WINDOW_SIZE=30
# SESSION_TIMEOUT_SECONDS=30
# CORS_ORIGINS=["http://localhost:5173"]
